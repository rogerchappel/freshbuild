{
  "name": "freshbuild",
  "version": "0.1.0",
  "description": "Local-first, agent-friendly build watcher and proof-of-work check runner.",
  "homepage": "https://github.com/rogerchappel/freshbuild#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/freshbuild.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/freshbuild/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cli": "./src/cli.js"
  },
  "files": [
    "src",
    "README.md",
    "docs",
    "examples",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/cli.js && node --test",
    "smoke": "node src/cli.js run --root test/fixtures/smoke-project --changed src/index.js --output .freshbuild/smoke",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm run check && npm run smoke && npm run package:smoke",
    "validate": "bash scripts/validate.sh"
  },
  "keywords": [
    "agent",
    "build",
    "watcher",
    "verification",
    "local-first",
    "proof-of-work"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "freshbuild": "./src/cli.js"
  }
}
