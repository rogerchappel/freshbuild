{
  "name": "freshbuild",
  "version": "0.1.0",
  "description": "Local-first build watcher that runs safe checks and writes proof artifacts for agent PRs.",
  "type": "module",
  "bin": {
    "freshbuild": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/**/*.test.js",
    "smoke": "npm run build && node dist/src/cli.js run --root fixtures/npm-basic --script test --out .freshbuild/smoke"
  },
  "keywords": [
    "agent",
    "build",
    "watch",
    "cli",
    "local-first",
    "proof"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5"
  }
}
